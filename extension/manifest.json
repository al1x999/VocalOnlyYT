{
  "manifest_version": 3,
  "name": "YouTube Instrument Remover",
  "version": "2.0.0",
  "description": "Removes instrumental/music from YouTube videos in 1 click or P shortcut.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
